# Скопируйте в .env и заполните. НИКОГДА не коммитьте .env.

# --- Базы / очередь (значения по умолчанию совпадают с docker-compose) ---
DATABASE_URL=postgresql+psycopg://osint:osint@postgres:5432/osint
CELERY_BROKER_URL=redis://redis:6379/0

# --- Разработка ---
# 1 = выполнять джобы прямо в API без Redis/Celery (только dev!)
EXEC_INLINE=0

# --- Таймауты коллекторов (сек) ---
COLLECTOR_TIMEOUT=120
MAIGRET_TIMEOUT=150
VK_FETCH_TIMEOUT=12

# --- Источники (Этап 1.1) ---
# Токен приложения VK (https://dev.vk.com) → сервисный ключ доступа.
# Без него vk_profile работает в режиме публичного scrape (og:* метаданные).
VK_TOKEN=
# Авто-выполнение dorks: serper.dev (рекомендуется; ключ на Dashboard после
# регистрации, бесплатные стартовые кредиты) ИЛИ SerpAPI (~100 запросов/мес).
# ВНИМАНИЕ: Google Custom Search JSON API с 2026 г. закрыт для новых клиентов
# (закрытие 01.01.2027) — пара GOOGLE_API_KEY+GOOGLE_CSE_ID работает только
# если у вас уже был старый доступ.
SERPER_API_KEY=
SERPAPI_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Сколько поисковых запросов исполнять на один джоб (экономия квоты):
DORK_MAX_EXEC=10

# --- Фото (Этап 2) ---
# Куда падают загрузки и где кэшируются ONNX-модели лиц (в compose задано
# абсолютное /app/... — эти значения для локального запуска без Docker):
UPLOAD_DIR=data/uploads
MODELS_DIR=models
MAX_UPLOAD_BYTES=15728640
PHASH_MAX_DISTANCE=6      # Hamming ≤ → фото считается тем же
FACE_STRONG=0.55           # cosine ≥ → «тот же человек» (вердикт strong)
FACE_POSSIBLE=0.45         # cosine ≥ → «похоже» (possible, на проверку)
PHOTO_TARGET_LIMIT=30      # сколько аватарок скачивать на один джоб

# --- Снимки страниц (Этап 2) ---
# Хранилище снимков: пусто → file-режим (data/snapshots). Для minio (профиль full): minio:9000
# Пусто → file-режим: SNAPSHOT_DIR (дев/тесты без Docker).
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=osint-snapshots
SNAPSHOT_DIR=data/snapshots

# --- Полнотекстовый поиск (Этап 2) ---
# В docker compose по умолчанию http://opensearch:9200.
# Пусто → SQL-fallback (ILIKE) — работает вообще без дополнительных сервисов.
OPENSEARCH_URL=
OPENSEARCH_INDEX=facts

# User-Agent для публичных запросов (укажите contact-адрес)
HTTP_USER_AGENT=OSINT-Person-Search/0.1 (+research; contact: admin@example.com)

# RBAC (Этап 4): ключи ролей через запятую — роль:ключ. Пусто = открытый режим (dev).
API_KEYS=
